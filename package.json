{
  "name": "keysetengine-drizzle",
  "version": "1.0.0",
  "description": "High-performance, database-agnostic keyset pagination and universal search library for Drizzle ORM on Node.js and Bun",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run build",
    "generate:llms": "node scripts/generate-llms-full.mjs",
    "docs:dev": "npm run generate:llms && vitepress dev docs",
    "docs:build": "npm run generate:llms && vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "keywords": [
    "drizzle",
    "drizzle-orm",
    "keyset-pagination",
    "cursor-pagination",
    "pagination",
    "sqlite",
    "postgresql",
    "mysql",
    "bun",
    "nodejs"
  ],
  "author": "Paul Abib Camano — Aebibtech (paul@aebibtech.com)",
  "license": "MIT",
  "peerDependencies": {
    "drizzle-orm": ">=0.35.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.1",
    "better-sqlite3": "^11.7.0",
    "bun-types": "^1.1.42",
    "drizzle-orm": "^0.38.3",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitepress": "^1.6.4"
  }
}
